# Telegram Bot
BOT_TOKEN=your_bot_token_here
OWNER_ID=your_telegram_user_id_here

# Environment
NODE_ENV=production
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://nftbot:change_this_password@db:5432/nftbot

# Redis
REDIS_URL=redis://redis:6379

# NFT Data Provider
# Get a FREE Alchemy API key at https://alchemy.com (no credit card needed)
# Without this key the bot runs in demo mode with mock data
ALCHEMY_API_KEY=

# OPTIONAL but recommended: OpenSea API key (free)
# Adds exact slug resolution + market stats (24h volume, sales, owners)
# Get one at https://docs.opensea.io/reference/api-keys
OPENSEA_API_KEY=

# OPTIONAL alternative to OpenSea: CoinGecko NFT API (free Demo key, instant)
# Adds floor price, 24h floor change, 24h volume/sales, and holder counts
# Sign up and create a Demo key at https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=

# Tracking Limits
MAX_TRACKED_COLLECTIONS=10
MAX_TRACKED_ASSETS=20
MAX_TRACKED_WALLETS=5

# Alert Settings
ALERT_COOLDOWN_MINUTES=30
DEFAULT_DIGEST_MODE=instant

# Worker Intervals (milliseconds)
MARKET_POLL_INTERVAL_ACTIVE=60000
MARKET_POLL_INTERVAL_NORMAL=300000
ASSET_POLL_INTERVAL=120000
HOLDER_POLL_INTERVAL=1800000
